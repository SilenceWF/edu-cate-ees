APP_NAME="edu-cate-ees"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The address people use on your intranet / VPN, e.g. http://training.company.local
APP_URL=http://localhost:8000

# Interface language when the pack does not say otherwise (el or en)
APP_LOCALE=el
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ── Database ──────────────────────────────────────────────────────────────
# SQLite works out of the box: everything is stored in database/database.sqlite.
# (With SQLite, DB_DATABASE is the path of that file, so leave it commented out.)
DB_CONNECTION=sqlite
# For MySQL 8 (docker-compose sets DB_HOST=db automatically):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=educateees
# DB_USERNAME=educateees
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ── Sign-in ───────────────────────────────────────────────────────────────
# Email + password login, for first setup and testing. Turn off once SSO works.
ENABLE_LOCAL_AUTH=true

# Microsoft Entra ID (Azure AD) single sign-on. Leave empty to hide the button.
# Redirect URI to register in Entra ID: <APP_URL>/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Wrong kiosk PIN / employee-code attempts allowed per 5 minutes
KIOSK_MAX_ATTEMPTS=5

# Set when running behind a reverse proxy, e.g. TRUSTED_PROXIES=10.0.0.0/8 (or *)
TRUSTED_PROXIES=

# ── Email (for reminders). With MAIL_MAILER=log the dashboard uses mailto: links instead.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="training@example.com"
MAIL_FROM_NAME="edu-cate-ees"

# docker-compose only
HTTP_PORT=8080
DB_ROOT_PASSWORD=
